[army]
name = "my-project"
base_branch = "main"
max_waves = 15
max_repairs_per_task = 1
task_timeout_sec = 1800             # Per-task clock. One re-dispatch, then BLOCKED.
create_draft_pr_on_complete = false

[commander]
harness = "pi"                      # "pi" or "opencode"
model = "anthropic/claude-sonnet-4-5"
thinking = "high"                   # Passed to pi --thinking when harness = "pi"
timeout_sec = 600

[seats.worker_1]
kind = "opencode"
model = "zai-coding-plan/glm-5.3"
role = "worker"
worktree = true
critical = true

[seats.worker_2]
kind = "opencode"
model = "zai-coding-plan/glm-5.3"
role = "worker"
worktree = true
critical = false

[seats.verifier]
kind = "claude"
model = "sonnet"
role = "verifier"
worktree = true
critical = true
